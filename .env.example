# Discord bot token (required)
DISCORD_BOT_TOKEN=

# Discord user ID of the owner (only this user can control the bot; leave empty to allow all)
OWNER_DISCORD_USER_ID=

# Root directory containing all git repos the agent can work in (required)
REPOS_ROOT=/path/to/repos

# Directory for SQLite database and Copilot session state
DATA_DIR=data

# Default Copilot model ID
DEFAULT_MODEL=gpt-5.4-mini

# Optional: explicit path to the Copilot CLI executable (defaults to 'copilot' on PATH)
COPILOT_CLI_PATH=

# If true, auto-approve ALL Copilot permission requests — dangerous, not recommended
DEFAULT_AUTO_APPROVE_PERMISSIONS=false

# If true, auto-approve read-only permission requests (reduces UX spam)
AUTO_APPROVE_READ_PERMISSIONS=true

# Seconds to wait for a single Copilot turn before timing out (10–3600)
TURN_TIMEOUT_SECONDS=900

# If true, show a debug dump in permission prompts to help diagnose unclear payloads
DEBUG_PERMISSION_PAYLOAD=false

# OpenAI API key for embeddings (required for RAG)
OPENAI_API_KEY=

# Embedding model (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# Number of related conversations to retrieve (default: 3)
RAG_TOP_K=3

# HTTP server port
PORT=5000
HOST=127.0.0.1
